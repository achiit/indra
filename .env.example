# ── Required ──────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Add $5 credit — GPT-4o-mini costs almost nothing
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk_your-groq-key-here
# Groq model (optional). Do not use retired ids like llama3-8b-8192 — see https://console.groq.com/docs/deprecations
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# LLM try-order (default: gemini first). Use Groq first if Gemini is always 429:
# INDRA_LLM_ORDER=groq,gemini,cerebras,openrouter
# Or disable Gemini completely:
# GEMINI_DISABLED=1

# ── Optional (recommended) ────────────────────────────────────────
# Free at: https://newsdata.io/register (takes 30 seconds)
# Gives you 200 req/day = 2000 India-specific news articles/day
NEWSDATA_API_KEY=pub_58a6523e840a49e89022e58599ef64be
